# Tavern 生产环境变量模板
# 复制此文件为 .env.prod 并填入真实值
# 注意：.env.prod 不得提交到版本控制

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com
DJANGO_SETTINGS_MODULE=tavern.settings.production
DEBUG=False

# CORS / CSRF
CORS_ALLOWED_ORIGINS=https://your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=tavern
MYSQL_USER=tavern
MYSQL_PASSWORD=change-me-to-a-strong-password
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-root-password

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# Security / exposure
ENABLE_API_DOCS=False
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Rate limits
THROTTLE_ANON_RATE=60/min
THROTTLE_USER_RATE=600/min
THROTTLE_AUTH_RATE=10/min
THROTTLE_REGISTER_RATE=5/hour
THROTTLE_UPLOAD_RATE=30/hour
THROTTLE_COMMENT_RATE=120/hour
THROTTLE_REPORT_RATE=30/hour
THROTTLE_SSE_RATE=20/min

# API
API_DEFAULT_PAGE_SIZE=20
