# Tavern 生产环境变量模板
# 复制此文件为 .env.prod 并填入真实值
# 注意：.env.prod 不得提交到版本控制

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com
DJANGO_SETTINGS_MODULE=tavern.settings.production
DEBUG=False

# CORS / CSRF
CORS_ALLOWED_ORIGINS=https://your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=tavern
MYSQL_USER=tavern
MYSQL_PASSWORD=change-me-to-a-strong-password
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-root-password

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# API
API_DEFAULT_PAGE_SIZE=20
