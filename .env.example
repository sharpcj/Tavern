# Django
DEBUG=True
DJANGO_SECRET_KEY=django-insecure-local-dev-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
# Use sqlite for quick local checks, mysql when running deploy/docker-compose.dev.yml.
DATABASE_ENGINE=sqlite
MYSQL_DATABASE=tavern
MYSQL_USER=tavern
MYSQL_PASSWORD=tavern_dev_password
MYSQL_ROOT_PASSWORD=tavern_root_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_DEFAULT_PAGE_SIZE=20
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
# Set true only when backend is started with ASGI server, e.g. uv run uvicorn tavern.asgi:application --host 0.0.0.0 --port 8000 --reload
VITE_ENABLE_SSE_STREAM=false
